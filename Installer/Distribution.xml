<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>AES67 Mac — Testversion @VERSION@</title>
  <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
  <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="x86_64,arm64"/>
  <allowed-os-versions><os-version min="11.0"/></allowed-os-versions>
  <license file="license.txt" mime-type="text/plain"/>
  <welcome file="welcome.html"/>
  <readme file="readme.html"/>
  <conclusion file="conclusion.html"/>
  <choices-outline><line choice="default"/></choices-outline>
  <choice id="default" title="AES67-Treiber, Manager und Clock-Dienst" description="Installiert AES67 Manager, CoreAudio-Treiber und PTP-Clock-Dienst. Nach Installation Mac neu starten. Spätere Einstellungen per CoreAudio-Neustart anwenden. AES67-Hardware muss kompatibel eingerichtet sein. Experimentell; Hardware- und macOS-11-Tests stehen noch aus."><pkg-ref id="org.communityaudio.aes67.x32"/></choice>
  <pkg-ref id="org.communityaudio.aes67.x32" version="@VERSION@" onConclusion="RequireRestart">component.pkg</pkg-ref>
</installer-gui-script>
